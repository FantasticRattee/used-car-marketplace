# Copy this file to Backend/.env and fill in your own values.
# .env is ignored by git. Never commit real passwords.

# --- MySQL connection ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-mysql-password
# The API uses its own database. `npm run seed` creates it if it does not exist.
DB_NAME=one2car
# Optional: connect through a Unix socket instead of host/port.
# DB_SOCKET=/tmp/mysql.sock

# --- API server ---
BACKEND_PORT=8080
# Browser origins allowed to call the API (comma-separated).
FRONTEND_ORIGIN=http://localhost:5500,http://127.0.0.1:5500
# How long an admin login stays valid.
SESSION_TTL_MINUTES=30

# --- Admin account created or updated by `npm run seed` ---
ADMIN_USERNAME=admin
# At least 10 characters. Pick your own; the seed refuses this placeholder.
ADMIN_PASSWORD=change-me-before-seeding
